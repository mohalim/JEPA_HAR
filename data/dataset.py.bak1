import os
import glob
import numpy as np
import pandas as pd
import torch
from torch.utils.data import Dataset

# =======================
# Base Dataset Class
# =======================
class BaseSensorDataset(Dataset):
    def __init__(
        self,
        root_dir,
        window_size=100,
        overlap=0.5,
        scaling="standard",
        eps=1e-8,
        file_ext="*.csv",
        has_label=True,   # NEW
    ):
        self.root_dir = root_dir
        self.window_size = window_size
        self.stride = int(window_size * (1 - overlap))
        self.scaling = scaling
        self.eps = eps
        self.file_ext = file_ext
        self.has_label = has_label

        assert self.stride > 0, "Overlap too large, stride becomes zero."

        self.subject_windows = {}     # {subject_id: [windows]}
        self.subject_labels = {} if has_label else None
        self.index_map = []           # list of (subject_id, window_idx)
        self.label_map = None

        self._load_all_subjects()

        if self.has_label:
            self._relabel_activities()

    def _compute_scaling_stats(self, all_signals):
        stats = {}
        if self.scaling == "standard":
            stats["mean"] = all_signals.mean(axis=0)
            stats["std"] = all_signals.std(axis=0)
        elif self.scaling == "minmax":
            stats["min"] = all_signals.min(axis=0)
            stats["max"] = all_signals.max(axis=0)
        elif self.scaling == "maxabs":
            stats["maxabs"] = np.abs(all_signals).max(axis=0)
        elif self.scaling is None:
            return None
        else:
            raise ValueError(f"Unknown scaling: {self.scaling}")
        return stats

    def _apply_scaling(self, signals):
        if self.scaling is None:
            return signals
        if self.scaling == "standard":
            return (signals - self.stats["mean"]) / (self.stats["std"] + self.eps)
        if self.scaling == "minmax":
            return (signals - self.stats["min"]) / (self.stats["max"] - self.stats["min"] + self.eps)
        if self.scaling == "maxabs":
            return signals / (self.stats["maxabs"] + self.eps)

    def _segment_subject(self, signals, labels=None):
        windows, win_labels = [], []
        num_samples = len(signals)

        for start in range(0, num_samples - self.window_size + 1, self.stride):
            end = start + self.window_size
            window = signals[start:end]
            windows.append(window)

            if self.has_label:
                label = np.bincount(labels[start:end]).argmax()
                win_labels.append(label)

        return windows, win_labels if self.has_label else None

    def _load_all_subjects(self):
        csv_files = sorted(glob.glob(os.path.join(self.root_dir, self.file_ext)))
        all_signals = []

        # ---------- First pass: scaling stats ----------
        for csv_path in csv_files:
            data = pd.read_csv(csv_path)
            signals = (
                data.iloc[:, :-1].values.astype(np.float32)
                if self.has_label
                else data.values.astype(np.float32)
            )
            all_signals.append(signals)

        all_signals = np.vstack(all_signals)
        self.stats = self._compute_scaling_stats(all_signals)

        # ---------- Second pass: windowing ----------
        for subject_id, csv_path in enumerate(csv_files):
            data = pd.read_csv(csv_path)

            if self.has_label:
                signals = data.iloc[:, :-1].values.astype(np.float32)
                labels = data.iloc[:, -1].values.astype(np.int64)
            else:
                signals = data.values.astype(np.float32)
                labels = None

            signals = self._apply_scaling(signals)
            windows, win_labels = self._segment_subject(signals, labels)

            self.subject_windows[subject_id] = windows

            if self.has_label:
                self.subject_labels[subject_id] = win_labels

            for w_idx in range(len(windows)):
                self.index_map.append((subject_id, w_idx))

    def _relabel_activities(self):
        """Relabel all activity labels to 0..num_classes-1"""
        all_labels = []
        for labels in self.subject_labels.values():
            all_labels.extend(labels)

        unique_labels = sorted(set(all_labels))
        self.label_map = {old: new for new, old in enumerate(unique_labels)}

        for subject_id in self.subject_labels:
            self.subject_labels[subject_id] = [
                self.label_map[l] for l in self.subject_labels[subject_id]
            ]

    def __len__(self):
        return len(self.index_map)



# =======================
# JEPA Dataset (Self-Supervised)
# =======================
class JEPASensorDataset(BaseSensorDataset):
    def __init__(self, root_dir, window_size=100, overlap=0.5, num_patches=5, mask_ratio=0.3, **kwargs):
        super().__init__(root_dir, window_size, overlap, **kwargs)
        self.num_patches = num_patches
        self.mask_ratio = mask_ratio
        assert window_size % num_patches == 0, "window_size must be divisible by num_patches"

    def _patchify(self, window):
        T, C = window.shape
        patch_size = T // self.num_patches
        patches = []
        for i in range(self.num_patches):
            start = i * patch_size
            end = start + patch_size
            patch = window[start:end].reshape(-1)
            patches.append(patch)
        return torch.stack(patches, dim=0)

    def __getitem__(self, idx):
        subject_id, window_idx = self.index_map[idx]
        window = torch.from_numpy(self.subject_windows[subject_id][window_idx])
        patches = self._patchify(window)
        N = patches.size(0)

        num_mask = max(1, round(self.mask_ratio * N))
        perm = torch.randperm(N)
        masked_idx = perm[:num_mask]
        visible_idx = perm[num_mask:]

        return {
            "visible_patches": patches[visible_idx],    # [Nv, T*C]
            "masked_patches": patches[masked_idx],      # [Nm, T*C]
            "visible_idx": visible_idx,
            "masked_idx": masked_idx,
            "all_patches": patches
        }


# =======================
# Supervised Dataset (Downstream Task)
# =======================
class SupervisedSensorDataset(BaseSensorDataset):
    def __getitem__(self, idx):
        subject_id, window_idx = self.index_map[idx]
        window = torch.from_numpy(self.subject_windows[subject_id][window_idx])
        label = self.subject_labels[subject_id][window_idx]
        return window, label


# =======================
# Sequential JEPA Dataset
# =======================
class SequentialJEPASensorDataset(JEPASensorDataset):
    def __init__(self, root_dir, window_size=100, overlap=0.5, num_patches=5, mask_ratio=0.3, k=2, **kwargs):
        super().__init__(root_dir, window_size, overlap, num_patches, mask_ratio, **kwargs)
        self.k = k              # number of windows in sequence
        assert len(self.index_map) >= k, "Dataset too small for the given k"

    def __getitem__(self, idx):
        # Ensure we don't go out of bounds
        if idx + self.k > len(self.index_map):
            idx = len(self.index_map) - self.k

        #windows_seq = []
        visible_seq = []
        masked_seq = []
        visible_idx_seq = []
        masked_idx_seq = []
        all_patches_seq = []

        # Use the same mask indices for both windows
        num_mask = max(1, round(self.mask_ratio * self.num_patches))
        mask_indices = torch.randperm(self.num_patches)[:num_mask] # Generate two random values [0-4]
        for i in range(self.k):
            subject_id, window_idx = self.index_map[idx + i]
            window = torch.from_numpy(self.subject_windows[subject_id][window_idx])
            patches = self._patchify(window)

            # Random mask WITHOUT permuting order
            # initialize mask
            mask = torch.zeros(self.num_patches, dtype=torch.bool) # a list of 5 Falses
            mask[mask_indices] = True

            '''
            # Random mask on the left end of right end
		    # initialize mask
            mask = torch.zeros(N, dtype=torch.bool)
            # randomly choose first p or last p patches
            if torch.rand(1).item() < 0.5:
                # mask first p patches
                mask[:num_mask] = True
            else:
                # mask last p patches
                mask[-num_mask:] = True
            '''

            # Add offset based on window position
            offset = i * self.num_patches
            masked_idx = torch.nonzero(mask, as_tuple=False).squeeze(1) + offset
            visible_idx = torch.nonzero(~mask, as_tuple=False).squeeze(1) + offset
            #perm = torch.randperm(N)
            #masked_idx = perm[:num_mask]
            #visible_idx = perm[num_mask:]

            #windows_seq.append(window)
            visible_seq.append(patches[visible_idx - offset])
            masked_seq.append(patches[masked_idx - offset])
            visible_idx_seq.append(visible_idx)
            masked_idx_seq.append(masked_idx)
            all_patches_seq.append(patches)

        return {
            #"windows": torch.stack(windows_seq),    # if k=2, [(T,C),(T,C)]
            "visible_patches": visible_seq,         # list of k tensors, if k=2, [(Nv,t*C), (Nv,t*6)] where t=T/N, T=window size, N=number of subwindows/patches
            "masked_patches": masked_seq,           # list of k tensors, if k=2, [(Nm,t*C), (Nm,t*C)]
            "visible_idx": visible_idx_seq,
            "masked_idx": masked_idx_seq,
            "all_patches": all_patches_seq          # list of k tensors, if k=2, [(N,120), (N,120)]
        }


# =======================
# Sequential Supervised Dataset
# =======================
class SequentialSupervisedSensorDataset(SupervisedSensorDataset):
    def __init__(self, root_dir, window_size=100, overlap=0.5, k=2, **kwargs):
        super().__init__(root_dir, window_size, overlap, **kwargs)
        self.k = k
        assert len(self.index_map) >= k, "Dataset too small for the given k"

    def __getitem__(self, idx):
        # Ensure we don't go out of bounds
        if idx + self.k > len(self.index_map):
            idx = len(self.index_map) - self.k

        windows_seq = []
        labels_seq = []

        for i in range(self.k):
            subject_id, window_idx = self.index_map[idx + i]
            window = torch.from_numpy(self.subject_windows[subject_id][window_idx])
            label = self.subject_labels[subject_id][window_idx]
            windows_seq.append(window)
            labels_seq.append(label)

        return torch.stack(windows_seq), torch.tensor(labels_seq)
